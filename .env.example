# Copy to .env and load it into your shell (see README). Values match compose.yaml.
PARAGRAM_ADDR=:8080
DATABASE_URL=postgres://paragram:paragram@localhost:5432/paragram?sslmode=disable
REDIS_URL=redis://localhost:6379/0
PARAGRAM_CORS_ORIGINS=http://localhost:5173
# Dev only. In production use a random value: openssl rand -base64 48
PARAGRAM_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
PARAGRAM_S3_ENDPOINT=http://localhost:9000
PARAGRAM_S3_ACCESS_KEY=paragram
PARAGRAM_S3_SECRET_KEY=paragram-dev-secret
PARAGRAM_S3_BUCKET=media
PARAGRAM_S3_PUBLIC_URL=http://localhost:9000/media
